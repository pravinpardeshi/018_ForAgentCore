# --- Bedrock LLM (LangGraph ChatBedrock) ---
# e.g. us.anthropic.claude-sonnet-4-20250514-v1:0, anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.2

# --- Bedrock Embeddings (must match your ingestion pipeline!) ---
# Ingestion and query embeddings MUST use the same model + dimensions.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2
BEDROCK_EMBEDDING_REGION=us-east-1
EMBEDDING_DIMS=1024

# --- PostgreSQL + pgvector ---
DB_HOST=your-rds-or-aurora-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=knowledge
DB_USER=ka_reader
# Either set DB_PASSWORD directly, or use Secrets Manager / IAM auth below:
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=5

# Optional: AWS Secrets Manager JSON secret {username,password,host,port,dbname}
# DB_SECRET_ARN=

# Optional: RDS IAM authentication (no static password)
# DB_USE_IAM_AUTH=false

# --- Service secrets (all optional; secret ARN wins, *_env vars are fallback) ---
# Generic globals JSON, e.g. {"INTERNAL_API_KEY": "..."} (injected into environ)
# APP_SECRET_ARN=

# ServiceNow: secret JSON {instance_url, username, password}
#   or OAuth shape {instance_url, client_id, client_secret}
# SNOW_SECRET_ARN=
# SNOW_INSTANCE_URL=https://your-instance.service-now.com
# SNOW_USERNAME=
# SNOW_PASSWORD=
# SNOW_CLIENT_ID=
# SNOW_CLIENT_SECRET=

# Jira: secret JSON {base_url, email, api_token}
# JIRA_SECRET_ARN=
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# --- Retrieval tuning ---
DEFAULT_TOP_K=5
MAX_TOP_K=20
MIN_SIMILARITY=0.0
HYBRID_KEYWORD_WEIGHT=0.3
STATEMENT_TIMEOUT_MS=15000

# --- Agent behaviour ---
KA_MAX_TOOL_STEPS=6
# Default pipeline mode: full|triage|knowledge|rca|solution (per-request "agent" overrides)
AGENT_MODE=full

# --- Conversation memory (LangGraph checkpointer, in-process) ---
# Same session_id continues the thread. Restart/redeploy wipes it.
# MEMORY_ENABLED=false → stateless: every turn answered independently.
MEMORY_ENABLED=true
# Keep last N user turns per thread (0 = unlimited). Changing needs restart.
MEMORY_MAX_TURNS=10
# AgentCore Memory service ID for durable cross-session recall (see README
# "Memory settings"). Empty = not used yet; setting it alone changes nothing
# until the recall integration lands.
# AGENTCORE_MEMORY_ID=
